Synteka.OrderCreator.create_order(items, name: "Тестовый заказ АСТРАХАНЬ + нефть")


items = [
  %{good_name: "Труба ppr ду25мм (апельсинка)", count: 180, unit_id: 1},
  %{good_name: "Угол 45град ppr ду25мм", count: 60, unit_id: 1},
  %{good_name: "Угол 90град ppr ду25мм", count: 40, unit_id: 1},
  %{good_name: "Заглушка ppr ду25", count: 30, unit_id: 1},
  %{good_name: "Муфта соед ду25мм ppr", count: 30, unit_id: 1},
  %{good_name: "Тройник канализационный рыжий 110×50(45град)×110", count: 18, unit_id: 1},
  %{good_name: "Манжета резиновая 50>25мм", count: 18, unit_id: 1}
]

# Добавляем external_id для каждой позиции (можно сгенерировать)
items_with_id = Enum.map(items, fn item ->
  Map.put(item, :external_id, "ext_#{:erlang.unique_integer([:positive])}")
end)

# Вызываем создание заказа
SuperBtrx.OrderCreator.create_order(items_with_id,
  name: "Заявка на трубы и фитинги",
  project_id: 12,
  finish_date: Date.add(Date.utc_today(), 30) |> Date.to_iso8601()
)
📌 Выбор библиотеки для HTTP
HTTPoison — простая, основана на hackney (вы уже её используете).

Req — современная, более удобная (рекомендуется для новых проектов).

Tesla — модульная, с middleware.

Для вашей задачи подойдёт HTTPoison, он уже добавлен в зависимости. Если хотите перейти на Req, добавьте {:req, "~> 0.4"} в mix.exs.

🧪 Проверка
После формирования списка items_with_id вызовите функцию create_order. Убедитесь, что единицы измерения (unit_id) соответствуют реальным ID в системе (для штук обычно 1). Если API ожидает unit: %{id: ...}, это уже реализовано в вашем модуле.

Если возникнут ошибки (например, неверный unit_id), получите список единиц через API (как обсуждали) и подставьте правильные ID.

Успешной интеграции!

